# SkillProof AI - Environment Configuration

# Database: defaults to SQLite for immediate local zero-setup; can use PostgreSQL in production
DATABASE_URL=sqlite:///./skillproof.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/skillproof

# GitHub API Integration (Optional but recommended to increase rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# LLM Provider: 'heuristic' (zero-cost offline mode), 'openai', or 'gemini'
LLM_PROVIDER=heuristic

# Provider API Keys (Used when LLM_PROVIDER is set to openai or gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server Configuration
PORT=8000
FRONTEND_URL=http://localhost:5173
